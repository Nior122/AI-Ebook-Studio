# AI Ebook Studio backend environment template
# Copy to backend/.env for local development. NEVER commit real secrets.

# --- Application ---
APP_NAME="AI Ebook Studio API"
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SQL_ECHO=false
SERVICE_NAME=ai-ebook-studio-api

# --- API versioning ---
API_V1_PREFIX=/api/v1
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ebook_studio
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Security / Auth ---
SECRET_KEY=change-me
JWT_SECRET=change-me-too
JWT_ALGORITHM=HS256

# --- AI providers (text) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=openai/gpt-4o-mini
AI_FALLBACK_ENABLED=true

# --- Image provider ---
POLLINATIONS_API_KEY=

# --- Storage abstraction (local | s3 | r2) ---
STORAGE_PROVIDER=local
STORAGE_BUCKET=ai-ebook-studio
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_LOCAL_ROOT=./var/storage

# --- Jobs and cache ---
REDIS_URL=redis://localhost:6379/0

# --- Token lifetimes ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
AI_FALLBACK_PROVIDER=local
AI_FALLBACK_MODEL=

# --- Optional extra providers ---
NVIDIA_NIM_API_KEY=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_MODEL=

# --- Clerk (optional: accept Clerk JWTs in the API, auto-provision users) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# --- Email (reset/verification links) ---
APP_BASE_URL=http://localhost:3000
EMAIL_FROM=AI Ebook Studio <no-reply@ai-ebook.studio>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REQUIRE_EMAIL_VERIFICATION=false

# --- Translation fallback (self-hosted LibreTranslate) ---
LIBRETRANSLATE_URL=

# --- Rate limiting + request body cap ---
RATE_LIMIT_ENABLED=true
MAX_REQUEST_BODY_MB=20
