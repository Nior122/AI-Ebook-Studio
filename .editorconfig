# EditorConfig — keeps file encoding and indentation consistent across editors
# and across the mixed TypeScript/Python/Markdown/YAML monorepo.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python uses 4-space indentation per PEP 8
[*.py]
indent_size = 4
max_line_length = 100

# YAML config files
[*.{yml,yaml}]
indent_size = 2

# Markdown: keep trailing spaces (two trailing spaces = hard line break)
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Makefiles require tabs
[Makefile]
indent_style = tab
