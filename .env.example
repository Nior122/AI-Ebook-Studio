# AI Ebook Studio environment template
# Copy to .env and replace placeholder values. NEVER commit real secrets.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="AI Ebook Studio API"
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SQL_ECHO=false
SERVICE_NAME=ai-ebook-studio-api

# ---------------------------------------------------------------------------
# API versioning
# ---------------------------------------------------------------------------
API_V1_PREFIX=/api/v1
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Frontend (public)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="AI Ebook Studio"
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL in hosted environments)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Security / Auth
# ---------------------------------------------------------------------------
SECRET_KEY=change-me
JWT_SECRET=change-me-too
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------------------
# AI providers (text). Business code uses the AI provider layer only.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=openai/gpt-4o-mini
AI_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------------
# Image provider abstraction
# ---------------------------------------------------------------------------
POLLINATIONS_API_KEY=

# ---------------------------------------------------------------------------
# Storage abstraction (local | s3 | r2)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_BUCKET=ai-ebook-studio
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_LOCAL_ROOT=./var/storage

# ---------------------------------------------------------------------------
# Jobs and cache
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
