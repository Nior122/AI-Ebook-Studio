# =============================================================================
# AI Ebook Studio — complete environment template
# =============================================================================
# Copy to .env (backend) / paste into your hosting dashboards.
# NEVER commit real secrets — this file is a template with placeholders.
#
# Backend host (Render):  paste the BACKEND section vars into the service env.
# Frontend host (Cloudflare Pages): paste the FRONTEND section vars.
# Database: Neon.tech — use the NON-POOLING connection string (see DATABASE_URL).
#
# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="AI Ebook Studio API"
SERVICE_NAME=ai-ebook-studio-api
APP_VERSION=1.0.0
APP_ENV=development            # production on Render
DEBUG=true                     # false in production
LOG_LEVEL=INFO
SQL_ECHO=false

# --- API ---
API_V1_PREFIX=/api/v1
API_VERSION=v1
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ai-ebook-studio.pages.dev

# =============================================================================
# DATABASE — Neon.tech
# =============================================================================
# IMPORTANT: use the NON-POOLING connection string from the Neon dashboard
# (Dashboard -> Connect -> "Connection string (Non-pooling)"), because asyncpg
# cannot use Neon's PgBouncer pooled endpoint reliably.
# Format:
#   postgresql+asyncpg://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/ebook_studio?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ebook_studio
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# =============================================================================
# SECURITY / AUTH
# =============================================================================
# Generate strong random values for production (Render can auto-generate).
SECRET_KEY=change-me
JWT_SECRET=change-me-too
JWT_ALGORITHM=HS256

# --- Token lifetimes (minutes / days / hours) ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# --- Rate limiting (auth endpoints: register/login/forgot/reset) ---
RATE_LIMIT_ENABLED=true

# --- Clerk (authentication) ---
# From https://dashboard.clerk.com -> API Keys
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
CLERK_JWKS_URL=https://YOUR_CLERK_APP.clerk.accounts.dev/.well-known/jwks.json

# =============================================================================
# EMAIL (password reset + email verification)
# =============================================================================
# Public URL of the app — used to build reset/verification links
APP_BASE_URL=http://localhost:3000
EMAIL_FROM="AI Ebook Studio <no-reply@ai-ebook.studio>"
# Leave SMTP_HOST empty for local dev: links are written to the backend log
# and returned as dev_link in API responses (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# When true, new registrations must verify their email before use
REQUIRE_EMAIL_VERIFICATION=false

# =============================================================================
# AI PROVIDERS (text) — all optional; the built-in local engine works with none
# =============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
POLLINATIONS_API_KEY=

# --- Provider selection ---
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=openai/gpt-4o-mini
AI_FALLBACK_ENABLED=true
AI_FALLBACK_PROVIDER=local
AI_FALLBACK_MODEL=

# --- Translation without a key: self-hosted LibreTranslate server ---
# Leave empty to require an AI key for translation (clear error otherwise).
LIBRETRANSLATE_URL=

# =============================================================================
# STORAGE (exports, covers, images) — local | s3 | r2
# =============================================================================
STORAGE_PROVIDER=local
STORAGE_BUCKET=ai-ebook-studio
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_LOCAL_ROOT=./var/storage

# =============================================================================
# JOBS / CACHE
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# FRONTEND (Next.js) — paste into Cloudflare Pages env vars / .env.local
# =============================================================================
# URL of the deployed backend (Render) including /api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Clerk publishable key (public — safe to expose to the browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
# Clerk secret key (server-side only — used by middleware/API routes)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
