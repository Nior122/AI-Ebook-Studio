# Frontend-specific ignore rules (inherit root .gitignore behavior).
# Keep build artifacts and local deps out of source control.

# dependencies
/node_modules

# next.js build output
/.next/
/out/

# production
/build

# local env (override the .gitignore exclusion): still ignore local env
.env*.local

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# typescript
*.tsbuildinfo
next-env.d.ts
